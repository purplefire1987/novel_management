properties:
  file.name:
    displayName: 档案
  id:
    displayName: 编号
  name:
    displayName: 名称
  aliases:
    displayName: 别名
  race:
    displayName: 种族
  race_groups:
    displayName: 族系（属›族）
  canon_status:
    displayName: 状态
  updated_at:
    displayName: 更新
views:
  - type: table
    name: 人物
    filters:
      and:
        - type == "character"
        - '!file.inFolder("99_Archive")'
    order:
      - file.name
      - id
      - race
      - aliases
      - canon_status
      - updated_at
  - type: table
    name: 势力
    filters:
      and:
        - type == "faction"
        - '!file.inFolder("99_Archive")'
    order:
      - file.name
      - id
      - aliases
      - canon_status
      - updated_at
  - type: table
    name: 地点
    filters:
      and:
        - type == "location"
        - '!file.inFolder("99_Archive")'
    order:
      - file.name
      - id
      - subtype
      - aliases
      - canon_status
      - updated_at
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 州域
    filters:
      and:
        - type == "location"
        - subtype == "州域"
        - '!file.inFolder("99_Archive")'
    order:
      - file.name
      - id
      - tags
      - updated_at
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 府级
    filters:
      and:
        - type == "location"
        - subtype == "府"
        - '!file.inFolder("99_Archive")'
    order:
      - file.name
      - id
      - aliases
      - updated_at
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 物品
    filters:
      and:
        - type == "item"
        - '!file.inFolder("99_Archive")'
    order:
      - file.name
      - id
      - canon_status
      - updated_at
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 敌人
    filters:
      and:
        - type == "enemy"
        - '!file.inFolder("99_Archive")'
    order:
      - file.name
      - id
      - race
      - canon_status
      - updated_at
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: 世界设定
    filters:
      and:
        - type == "world"
        - '!file.inFolder("99_Archive")'
    order:
      - file.name
      - id
      - updated_at
    sort:
      - property: id
        direction: ASC
    columnSize:
      file.name: 291
  - type: table
    name: 种族
    filters:
      and:
        - type == "world"
        - subtype == "种族表"
        - '!file.inFolder("99_Archive")'
    order:
      - file.name
      - id
      - canon_status
      - updated_at
    sort:
      - property: id
        direction: ASC
  - type: table
    name: 大纲与卷
    filters:
      and:
        - '!file.inFolder("99_Archive")'
        - or:
            - type == "volume"
            - type == "chapter_outline"
    order:
      - file.name
      - id
      - canon_status
      - updated_at
  - type: cards
    name: 全部实体卡片
    filters:
      and:
        - '!file.inFolder("99_Archive")'
    order:
      - file.name
      - id
      - canon_status
    limit: 60
  - type: table
    name: 旧稿存档（CH-10xx）
    filters:
      and:
        - file.inFolder("99_Archive/Original_Draft")
        - type == "manuscript"
    order:
      - file.name
      - id
      - word_count
      - canon_status
  - type: table
    name: 技能
    filters:
      and:
        - type == "skill"
        - '!file.inFolder("99_Archive")'
    order:
      - file.name
      - id
      - subtype
      - grade
      - school
      - canon_status
    sort:
      - property: subtype
        direction: ASC
      - property: id
        direction: ASC
  - type: table
    name: 命格
    filters:
      and:
        - type == "destiny"
        - '!file.inFolder("99_Archive")'
    order:
      - file.name
      - id
      - updated_at
    sort:
      - property: id
        direction: ASC
