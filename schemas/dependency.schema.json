{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/novel-system/dependency.schema.json",
  "title": "依赖（产物依赖谁、失效到哪一步）",
  "$comment": "字段依据 PRD §10.5。只有相关依赖变化才使产物失效——所以每条依赖都记 content_hash。",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "depends_on", "validation_status"],
  "properties": {
    "id": { "$ref": "_common.schema.json#/$defs/anyId" },
    "artifact_type": { "const": "DEPENDENCY" },
    "artifact_status": { "$ref": "_common.schema.json#/$defs/artifactStatus" },
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
    "created_by_task": { "type": "string", "pattern": "^TSK-[0-9A-HJKMNP-TV-Z]{26}$" },
    "derived_from": { "type": "array", "items": { "$ref": "_common.schema.json#/$defs/anyId" } },
    "supersedes": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "extensions": { "type": "object" },
    "artifact_id": {
      "$ref": "_common.schema.json#/$defs/anyId",
      "description": "被依赖方（依赖关系的持有者）"
    },
    "depends_on": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "dependency_type"],
        "properties": {
          "artifact_id": { "$ref": "_common.schema.json#/$defs/anyId" },
          "content_hash": { "$ref": "_common.schema.json#/$defs/sha256" },
          "dependency_type": { "type": "string", "enum": ["HARD", "SOFT"] }
        }
      }
    },
    "validation_status": {
      "type": "string",
      "enum": ["VALID", "STALE", "NEEDS_REVIEW"]
    },
    "checked_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" }
  }
}
