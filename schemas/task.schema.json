{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/novel-system/task.schema.json",
  "title": "任务记录（Agent 交接的最小单元）",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "project_id", "author_id", "task_type", "status", "created_at"],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TSK-[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "V1.3 §27.2 的 `TSK-<ULID>`。三代旧号（`TASK-000001` / `task_000001` / V1.3 之前的六位序号）都不再合法，只由 `legacy-ids` 报告"
    },
    "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "author_id": { "type": "string", "minLength": 1, "description": "任务所属作者；与 project_id、task_id 一起构成任务的最小身份" },
    "task_type": {
      "type": "string",
      "enum": [
        "outline",
        "preflight",
        "draft",
        "revision",
        "review",
        "memory_update",
        "ingest",
        "simulation",
        "release"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "ready",
        "running",
        "waiting_review",
        "approved",
        "rejected",
        "completed",
        "blocked",
        "paused",
        "failed",
        "cancelled"
      ],
      "description": "V1.0 §10.4 的十一态。V4.0 的 pending/in_progress/awaiting_author/done 不再写入，但读盘时归一（tasks.LEGACY_STATUS），旧 runtime 目录里的任务仍读得出来"
    },
    "status_history": {
      "type": "array",
      "description": "V1.0 §10.4：每次状态迁移记录操作者、时间、原因和关联任务",
      "items": {
        "type": "object",
        "required": ["from", "to", "at"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "at": { "type": "string" },
          "by": { "type": "string" },
          "reason": { "type": "string" },
          "related_task_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "assigned_to": {
      "type": "string",
      "enum": [
        "editor_in_chief",
        "world_architect",
        "editor",
        "dice_mistress",
        "researcher",
        "writer",
        "memory_keeper",
        "ingestor",
        "version_manager"
      ]
    },
    "input_files": { "type": "array", "items": { "type": "string" } },
    "output_files": { "type": "array", "items": { "type": "string" } },
    "output_scope": { "type": "string", "description": "允许写入的目录前缀，越界即失败" },
    "write_mode": { "type": "string", "enum": ["read_only", "staging", "draft", "proposal"] },
    "approval_state": {
      "type": "string",
      "enum": ["not_required", "pending_author", "approved", "rejected"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "closed_at": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" }
  }
}
