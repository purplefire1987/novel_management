{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/novel-system/project.schema.json",
  "title": "小说项目元数据",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "project_name",
    "project_slug",
    "author_id",
    "created_at",
    "project_status",
    "schema_version"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "不可变且唯一；只允许小写字母、数字、连字符"
    },
    "project_name": { "type": "string", "minLength": 1 },
    "project_slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "author_id": { "type": "string", "minLength": 1 },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T.*)?$",
      "description": "PRD §8.2 要求带时区的 ISO 8601；库内现为纯日期（'2026-11-20'），故两种都接受"
    },
    "project_status": {
      "type": "string",
      "enum": ["draft", "active", "paused", "completed", "archived"]
    },
    "canon_root": { "type": "string", "default": "01_Canon" },
    "planning_root": { "type": "string", "default": "02_Planning" },
    "manuscript_root": { "type": "string", "default": "03_Manuscripts" },
    "staging_root": { "type": "string", "default": "07_Staging" },
    "archive_root": { "type": "string", "default": "90_Archive" },
    "timezone": { "type": "string", "default": "Asia/Shanghai" },
    "schema_version": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" }
      ],
      "description": "库内为 '4.0.0'（规范版本），早期实现用整数。两种都收，新项目请用点分字符串"
    },
    "structure_note": {
      "type": "string",
      "description": "结构迁移说明（v1.0 遗留字段，迁移完成后可移除）"
    }
  },
  "propertyNames": { "not": { "pattern": "\\.\\." } }
}
