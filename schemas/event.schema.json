{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/novel-system/event.schema.json",
  "title": "世界内事件（时间线事实）",
  "$comment": "字段依据 PRD §9.3 与 §8.1。库内现存 7 份全为 EVT-CH-xxxx-yyy 复合形态，PRD 禁止；新事件一律纯序号，旧事件迁移见 known_risks。",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "summary"],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^EVT-[0-9]{4,6}$",
      "description": "纯序号，不得把章节号编进 ID——章节会重排，事件不会"
    },
    "artifact_type": { "const": "EVENT" },
    "artifact_status": { "$ref": "_common.schema.json#/$defs/artifactStatus" },
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
    "created_by_task": { "type": "string", "pattern": "^TASK-[0-9]{4,6}$" },
    "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string" },
    "summary": { "type": "string", "minLength": 1 },
    "world_time": {
      "type": "string",
      "description": "世界内时间；允许模糊（如「第三年春」），但不得与已确认时间线矛盾"
    },
    "timeline_id": { "type": "string", "description": "所属时间线，如 TL-MAIN" },
    "sequence": { "type": "integer", "minimum": 0 },
    "participants": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(CHAR|FAC|ORG|CREATURE|LOC|ITEM)-[0-9]{4,6}$" }
    },
    "location": { "type": "string", "pattern": "^LOC-[0-9]{4,6}$" },
    "consequences": { "type": "array", "items": { "type": "string" } },
    "source_chapter": { "type": "string", "pattern": "^CH-[0-9]{4,6}$" },
    "derived_from": {
      "type": "array",
      "description": "上游产物 ID。PRD §8.2 里这是数组，不是枚举",
      "items": { "$ref": "_common.schema.json#/$defs/anyId" }
    },
    "supersedes": { "type": ["string", "null"] },
    "source_kind": {
      "type": "string",
      "enum": ["manuscript", "author_note"],
      "description": "只能来自正文或作者手记；Agent 推演不构成事件"
    },
    "source_refs": { "$ref": "_common.schema.json#/$defs/sourceRefList" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "extensions": { "type": "object" }
  }
}
